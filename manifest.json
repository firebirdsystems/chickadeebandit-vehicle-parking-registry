{
  "id": "vehicle-parking-registry",
  "contexts": ["household", "shared_space"],
  "name": "Vehicle & Parking Registry",
  "version": "1.0.0",
  "description": "Register household vehicles and parking spots/permits; leadership manages assignments and flags non-compliant vehicles.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["hoa", "vehicles", "parking", "permits", "compliance", "board"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": ["app.violation-tracking.pending_violations"]
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": true
  },
  "storage": "db",
  "db_plaintext_columns": ["label"],
  "row_policies": {
    "settings": { "kind": "app_config" },
    "vehicles": {
      "kind": "owner_only",
      "member_column": "owner_id",
      "adults_bypass": false,
      "delete_privileged_only": true,
      "privileged_groups": [
        { "settings_table": "settings", "settings_key": "board_group_id" }
      ]
    },
    "parking_spots": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [
        { "settings_table": "settings", "settings_key": "board_group_id" }
      ]
    },
    "flags": {
      "kind": "inherit_visibility",
      "fk_column": "vehicle_id",
      "parent_table": "vehicles",
      "writer_column": "flagged_by",
      "insert_privileged_only": true
    }
  },
  "admin_config": {
    "settings_table": "settings",
    "keys": ["board_group_id"]
  },
  "notification_acls": {
    "send": {
      "require_group_setting": {
        "settings_table": "settings",
        "settings_key": "board_group_id"
      }
    }
  },
  "resource_limits": {
    "max_db_bytes": 52428800
  },
  "member_references": {
    "vehicles": {
      "column": "owner_id",
      "on_removed": "delete",
      "dependent_tables": [
        {
          "table": "flags",
          "foreign_key": "vehicle_id"
        }
      ]
    },
    "parking_spots": [
      { "column": "created_by", "on_removed": "keep" },
      { "column": "assigned_unit_id", "on_removed": "null" }
    ],
    "flags": { "column": "flagged_by", "on_removed": "keep" }
  },
  "delete_cascades": {
    "vehicles": [
      { "table": "flags", "foreign_key": "vehicle_id" }
    ]
  },
  "nav": { "label": "Parking" },
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COUNT(*) AS n FROM app_vehicle_parking_registry__flags f JOIN app_vehicle_parking_registry__vehicles v ON v.id = f.vehicle_id WHERE f.status = 'open' LIMIT 1"
    },
    "display": {
      "template": "badge",
      "count": "n",
      "label": "parking flags on your vehicles",
      "severity": "warn"
    }
  },
  "icon": "🚗"
}
