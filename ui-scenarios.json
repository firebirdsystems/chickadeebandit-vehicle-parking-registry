          "as": "owner",
          "selector": "[data-testid=\"tab\"][data-tab-id=\"spots\"]"
        },
        {
          "action": "click",
          "as": "owner",
          "selector": "[data-testid=\"tab\"][data-tab-id=\"spots\"]"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"spot-tile\"][data-spot-id=\"ui-spot\"]"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"add-spot\"]"
        },
        {
          "action": "click",
          "as": "owner",
          "selector": "[data-testid=\"spot-tile\"][data-spot-id=\"ui-spot\"]"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"spot-detail-modal\"]"
        },
        {
          "action": "expectText",
          "as": "owner",
          "text": "Lot A-12",
          "selector": "[data-testid=\"spot-detail-modal\"]"
        },
        {
          "action": "expectVisible",
          "as": "owner",
          "selector": "[data-testid=\"spot-detail-modal\"] [data-testid=\"edit-spot\"]"
        }
      ]
    }
  ]
}
